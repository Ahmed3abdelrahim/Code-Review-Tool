# Copy to .env and replace the placeholders. Never commit .env.
# Variables are documented in docs/Code_Review_IMPLEMENTATION_PLAN.md, Appendix E.

# --- Postgres container (compose.yaml) ---
POSTGRES_DB=aireviewer
POSTGRES_USER=aireviewer
POSTGRES_PASSWORD=change-me
# Host port, bound to 127.0.0.1 only (5432 is taken on the shared server).
AIREVIEW_PG_PORT=55432

# --- Application: required ---
AIREVIEW_DATABASE_URL=postgresql+psycopg://aireviewer:change-me@localhost:55432/aireviewer
AIREVIEW_GITHUB_APP_ID=000000
AIREVIEW_GITHUB_APP_SLUG=your-app-slug
# Worker only: path to the App private key (file stays outside the repository).
AIREVIEW_GITHUB_PRIVATE_KEY_PATH=/path/to/app-private-key
# API only: at least 32 characters (e.g. `openssl rand -hex 32`).
AIREVIEW_GITHUB_WEBHOOK_SECRET=change-me-to-64-hex-characters-from-openssl-rand-hex-32

# --- Application: model (required from Phase 3) ---
# AIREVIEW_MODEL_PROVIDER=anthropic
# AIREVIEW_MODEL_ID=
# AIREVIEW_MODEL_API_KEY=
# AIREVIEW_MODEL_BASE_URL=
# AIREVIEW_DAILY_COST_LIMIT_USD=

# --- Application: optional (defaults shown) ---
# AIREVIEW_MODEL_TIMEOUT_S=120
# AIREVIEW_WORKSPACE_ROOT=/var/lib/aireviewer/work
# AIREVIEW_WORKSPACE_QUOTA_MB=2048
# AIREVIEW_MAX_CONCURRENT_RUNS=2
# AIREVIEW_TOOL_PARALLELISM=3
# AIREVIEW_LLM_PARALLELISM=3
# AIREVIEW_LOG_LEVEL=INFO
